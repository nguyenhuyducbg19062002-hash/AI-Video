{
  "manifest_version": 3,
  "name": "AI Film Maker - Anti-Detect & Flow Helper",
  "version": "1.0.0",
  "description": "Bypass bot detection & auto-helper for Google Flow automation",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*", "*://flow.google.com/*", "*://*/*"],
      "js": ["content_main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.google.com/*", "*://flow.google.com/*", "*://*/*"],
      "js": ["content_isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"]
}
